  "components": [
    {
      "name": "主按钮",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "目录唯一主新建操作；表单主操作复用同一颜色。",
      "html": "<button class=\"ds-primary\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\"/></svg>新建入口</button>",
      "css": ".ds-primary{font-family:inherit;font-size:13px;font-weight:500;line-height:1.6;display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:36px;padding:7px 12px;border:1px solid var(--line, #dce5dd);border-radius:var(--radius-control, 8px);color:var(--subtle, #435c4f);background:var(--surface, #ffffff);transition:background-color 150ms var(--ease, cubic-bezier(0.16, 1, 0.3, 1)),color 150ms var(--ease, cubic-bezier(0.16, 1, 0.3, 1)),border-color 150ms var(--ease, cubic-bezier(0.16, 1, 0.3, 1));cursor:pointer;min-height:40px;padding:9px 16px;border-color:transparent;color:var(--on-accent, #ffffff);background:var(--accent, #2c6b50);font-weight:600;}.ds-primary:hover{color:var(--on-accent, #ffffff);background:var(--accent-hover, #22583f);}.ds-primary:focus-visible{outline:2px solid var(--focus, #377b5c);outline-offset:3px;}.ds-primary:active{filter:brightness(.96);}.ds-primary:disabled{cursor:not-allowed;opacity:.55;}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none;animation:none;}}"
    },
    {
